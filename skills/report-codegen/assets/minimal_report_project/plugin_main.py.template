# coding: utf-8
import json
import os
import sys

from common_utils.all_modules import logger
from common_utils.runtime_contract import normalize_parameters, validate_runtime_environment
from main_execute import ReportPipeline
from params_configs.execution_contract import execution_contract

os.chdir(os.path.dirname(os.path.abspath(__file__)))


def _assert_runtime_enabled():
    marker_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "SAFE_SCAFFOLD.json")
    if not os.path.isfile(marker_path):
        return
    with open(marker_path, "r", encoding="utf-8") as handle:
        marker = json.load(handle)
    if marker.get("status") == "SAFE_SCAFFOLD" or marker.get("runtime_enabled") is False:
        raise RuntimeError(
            "SAFE_SCAFFOLD runtime is disabled; resolve contract blockers and regenerate without --allow-blocked-scaffold"
        )


def main(params: dict):
    _assert_runtime_enabled()
    params = normalize_parameters(params, execution_contract)
    validate_runtime_environment(params, execution_contract)
    # Security: expose only operational routing fields, never the raw payload.
    logger.info(
        "dispatch component={} period={} current_date={} activation_enabled={}",
        params.get("component") or params.get("project_type") or "report",
        params.get("period"),
        params.get("current_date"),
        bool(params.get("is_run_pipeline", False)),
    )
    return ReportPipeline(params).execute()


def _load_platform_params(params_path: str, profile=None):
    from common_utils.project_contracts import load_entry
    from entry_contract import ENTRY_PROFILE
    return load_entry(params_path, ENTRY_PROFILE if profile is None else profile)


if __name__ == "__main__":
    params, result_path = _load_platform_params(sys.argv[1])
    result = main(params)
    with open(result_path, "w", encoding="utf-8") as handle:
        handle.write(json.dumps(result, ensure_ascii=False))
